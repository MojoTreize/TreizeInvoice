@page "/app/kunden"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IClientService ClientService

<PageTitle>Kunden — TreizeInvoice</PageTitle>

<div class="page-head">
    <div>
        <h1 class="underlined">Kunden</h1>
        <p class="greeting-sub">Diese Angaben erscheinen auf Ihren Rechnungen.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/app/kunden/neu">+ Neuer Kunde</a>
    </div>
</div>

<section class="panel">
<div class="mb-3">
    <input class="form-control" placeholder="Suchen (Name, Ansprechpartner, E-Mail)…"
           value="@_search" @oninput="OnSearchInput" />
</div>

@if (_clients is null)
{
    <p>Wird geladen…</p>
}
else if (_clients.Count == 0)
{
    <p class="text-muted">
        @(string.IsNullOrWhiteSpace(_search) ? "Noch keine Kunden." : "Keine Kunden zu dieser Suche.")
    </p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Ansprechpartner</th>
                <th>E-Mail</th>
                <th>Telefon</th>
                <th class="text-end">Aktionen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _clients)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.ContactPerson</td>
                    <td>@c.Email</td>
                    <td>@c.Phone</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="@($"/app/kunden/{c.Id}")">Bearbeiten</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(c)">Löschen</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
</section>

@if (_pendingDelete is not null)
{
    <div class="alert alert-warning">
        <p>
            <strong>@_pendingDelete.Name</strong> löschen ?
            @if (_pendingDeleteInvoices > 0)
            {
                <span>
                    Zu diesem Kunden gehören @_pendingDeleteInvoices Rechnung(en). Der Kunde
                    wird ausgeblendet, aber zur Nachvollziehbarkeit aufbewahrt (GoBD).
                </span>
            }
        </p>
        <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete">Löschen</button>
        <button class="btn btn-sm" @onclick="() => _pendingDelete = null">Abbrechen</button>
    </div>
}

@code {
    private List<Client>? _clients;
    private string _search = string.Empty;
    private Client? _pendingDelete;
    private int _pendingDeleteInvoices;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _clients = await ClientService.SearchAsync(_search);

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        await Load();
    }

    private async Task AskDelete(Client c)
    {
        _pendingDelete = c;
        _pendingDeleteInvoices = await ClientService.CountInvoicesAsync(c.Id);
    }

    private async Task ConfirmDelete()
    {
        if (_pendingDelete is null) return;
        await ClientService.SoftDeleteAsync(_pendingDelete.Id);
        _pendingDelete = null;
        await Load();
    }
}
