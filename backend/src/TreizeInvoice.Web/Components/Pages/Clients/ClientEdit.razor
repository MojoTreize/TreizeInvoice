@page "/app/kunden/neu"
@page "/app/kunden/{Id:int}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IClientService ClientService
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Neuer Kunde" : "Kunde bearbeiten") — TreizeInvoice</PageTitle>

<h1 class="underlined">@(IsNew ? "Neuer Kunde" : "Kunde bearbeiten")</h1>

<section class="panel">
@if (_client is null)
{
    <p>Wird geladen…</p>
}
else
{
    <EditForm Model="_client" OnValidSubmit="SaveAsync" FormName="client">
        <DataAnnotationsValidator />

        <div class="row">
            <div class="form-group col-md-6">
                <label>Name / Firma *</label>
                <InputText class="form-control" @bind-Value="_client.Name" />
                <ValidationMessage For="() => _client.Name" />
            </div>
            <div class="form-group col-md-6">
                <label>Ansprechpartner</label>
                <InputText class="form-control" @bind-Value="_client.ContactPerson" />
            </div>
        </div>

        <div class="form-group">
            <label>Anschrift</label>
            <InputTextArea class="form-control" rows="3" @bind-Value="_client.Address" />
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <label>E-Mail</label>
                <InputText class="form-control" @bind-Value="_client.Email" />
                <ValidationMessage For="() => _client.Email" />
            </div>
            <div class="form-group col-md-6">
                <label>Telefon</label>
                <InputText class="form-control" @bind-Value="_client.Phone" />
            </div>
        </div>

        <div class="form-group">
            <label>Anmerkungen</label>
            <InputTextArea class="form-control" rows="2" @bind-Value="_client.Notes" />
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Speichern</button>
            <a class="btn" href="/app/kunden">Abbrechen</a>
        </div>
    </EditForm>
}
</section>

@code {
    [Parameter] public int? Id { get; set; }

    private Client? _client;
    private bool IsNew => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew)
        {
            _client = new Client();
        }
        else
        {
            _client = await ClientService.GetAsync(Id!.Value);
            if (_client is null)
            {
                Nav.NavigateTo("/app/kunden");
            }
        }
    }

    private async Task SaveAsync()
    {
        if (_client is null) return;

        if (IsNew)
            await ClientService.CreateAsync(_client);
        else
            await ClientService.UpdateAsync(_client);

        Nav.NavigateTo("/app/kunden");
    }
}
