@page "/app/einstellungen"
@attribute [Authorize]
@* Sans prérendu : la page ne s'affiche qu'une fois interactive, sinon les boutons restent inertes. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@inject IBusinessProfileService ProfileService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Einstellungen — TreizeInvoice</PageTitle>

<h1 class="underlined">Einstellungen</h1>

<section class="panel">
<div class="panel-head">
    <h2 class="underlined accent">Unternehmensangaben</h2>
    <span class="panel-note">Erscheinen auf jeder Rechnung (§14 UStG)</span>
</div>

@if (_profile is null)
{
    <p>Wird geladen…</p>
}
else
{
    <EditForm Model="_profile" OnValidSubmit="SaveProfileAsync" FormName="profile">
        <DataAnnotationsValidator />

        @if (_profileSaved)
        {
            <div class="alert alert-success" role="alert">Angaben gespeichert.</div>
        }

        <div class="row">
            <div class="form-group col-md-6">
                <label for="fullName">Name / Firma</label>
                <InputText id="fullName" class="form-control" @bind-Value="_profile.FullName" />
            </div>
            <div class="form-group col-md-6">
                <label for="email">E-Mail</label>
                <InputText id="email" class="form-control" @bind-Value="_profile.Email" />
            </div>
        </div>

        <div class="form-group">
            <label for="address">Anschrift</label>
            <InputTextArea id="address" class="form-control" rows="3" @bind-Value="_profile.Address" />
        </div>

        <div class="row">
            <div class="form-group col-md-4">
                <label for="phone">Telefon</label>
                <InputText id="phone" class="form-control" @bind-Value="_profile.Phone" />
            </div>
            <div class="form-group col-md-4">
                <label for="steuernummer">Steuernummer</label>
                <InputText id="steuernummer" class="form-control" @bind-Value="_profile.Steuernummer" />
            </div>
            <div class="form-group col-md-4">
                <label for="numberFormat">Nummernformat</label>
                <InputText id="numberFormat" class="form-control" @bind-Value="_profile.NumberFormat" />
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-5">
                <label for="iban">IBAN</label>
                <InputText id="iban" class="form-control" @bind-Value="_profile.Iban" />
            </div>
            <div class="form-group col-md-3">
                <label for="bic">BIC</label>
                <InputText id="bic" class="form-control" @bind-Value="_profile.Bic" />
            </div>
            <div class="form-group col-md-4">
                <label for="bankName">Bank</label>
                <InputText id="bankName" class="form-control" @bind-Value="_profile.BankName" />
            </div>
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" id="klein" @bind-Value="_profile.IsKleinunternehmer" />
            <label class="form-check-label" for="klein">
                Kleinunternehmer (§19 UStG — keine Umsatzsteuer)
            </label>
        </div>

        <button type="submit" class="btn btn-primary">Speichern</button>
    </EditForm>
}
</section>

<section class="panel">
<div class="panel-head">
    <h2 class="underlined">Nachweise für das Finanzamt</h2>
    <span class="panel-note">GoBD</span>
</div>

<p>
    Die GoBD verlangen eine <strong>Verfahrensdokumentation</strong>: eine schriftliche
    Beschreibung, wie Ihre Rechnungen entstehen, nummeriert, festgeschrieben, archiviert
    und gesichert werden. Fehlt sie, ist das bei einer Betriebsprüfung einer der
    häufigsten Beanstandungspunkte.
</p>
<p>
    TreizeInvoice erzeugt dieses Dokument auf Knopfdruck aus dem tatsächlichen Zustand
    Ihrer Installation — mit Ihrem Nummernkreis, Ihren Beständen und dem Zeitraum Ihres
    Prüfprotokolls. Erstellen Sie es neu, wenn sich etwas Wesentliches ändert, und
    bewahren Sie ältere Fassungen zusammen mit Ihren Buchführungsunterlagen auf.
</p>

<div class="doc-actions">
    <a class="btn btn-primary" href="/app/verfahrensdokumentation">Verfahrensdokumentation als PDF</a>
    <a class="btn btn-outline-primary" href="/app/sicherung">Sicherung herunterladen</a>
</div>
</section>

<section class="panel">
<div class="panel-head">
    <h2 class="underlined">Passwort ändern</h2>
</div>

<EditForm Model="_pwd" OnValidSubmit="ChangePasswordAsync" FormName="password">
    <DataAnnotationsValidator />

    @if (_pwdMessage is not null)
    {
        <div class="alert @(_pwdSuccess ? "alert-success" : "alert-danger")" role="alert">@_pwdMessage</div>
    }

    <div class="row">
        <div class="form-group col-md-4">
            <label for="pwdCurrent">Aktuelles Passwort</label>
            <InputText id="pwdCurrent" type="password" autocomplete="current-password" class="form-control" @bind-Value="_pwd.Current" />
            <ValidationMessage For="() => _pwd.Current" />
        </div>
        <div class="form-group col-md-4">
            <label for="pwdNew">Neues Passwort</label>
            <InputText id="pwdNew" type="password" autocomplete="new-password" class="form-control" @bind-Value="_pwd.New" />
            <ValidationMessage For="() => _pwd.New" />
        </div>
        <div class="form-group col-md-4">
            <label for="pwdConfirm">Bestätigen</label>
            <InputText id="pwdConfirm" type="password" autocomplete="new-password" class="form-control" @bind-Value="_pwd.Confirm" />
            <ValidationMessage For="() => _pwd.Confirm" />
        </div>
    </div>

    <button type="submit" class="btn btn-outline-primary">Passwort ändern</button>
</EditForm>
</section>

@code {
    private BusinessProfile? _profile;
    private bool _profileSaved;

    private readonly PasswordModel _pwd = new();
    private string? _pwdMessage;
    private bool _pwdSuccess;

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileService.GetAsync();
    }

    private async Task SaveProfileAsync()
    {
        if (_profile is null) return;
        await ProfileService.SaveAsync(_profile);
        _profileSaved = true;
    }

    private async Task ChangePasswordAsync()
    {
        _pwdMessage = null;

        if (_pwd.New != _pwd.Confirm)
        {
            _pwdSuccess = false;
            _pwdMessage = "Die Bestätigung stimmt nicht mit dem neuen Passwort überein.";
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var idValue = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!int.TryParse(idValue, out var userId))
        {
            _pwdSuccess = false;
            _pwdMessage = "Sitzung ungültig. Bitte melden Sie sich erneut an.";
            return;
        }

        var ok = await AuthService.ChangePasswordAsync(userId, _pwd.Current, _pwd.New);
        _pwdSuccess = ok;
        _pwdMessage = ok
            ? "Passwort geändert."
            : "Das aktuelle Passwort ist falsch.";

        if (ok)
        {
            _pwd.Current = _pwd.New = _pwd.Confirm = string.Empty;
        }
    }

    private class PasswordModel
    {
        [Required(ErrorMessage = "Pflichtfeld.")]
        public string Current { get; set; } = string.Empty;

        [Required(ErrorMessage = "Pflichtfeld.")]
        [MinLength(6, ErrorMessage = "Mindestens 6 Zeichen.")]
        public string New { get; set; } = string.Empty;

        [Required(ErrorMessage = "Pflichtfeld.")]
        public string Confirm { get; set; } = string.Empty;
    }
}
