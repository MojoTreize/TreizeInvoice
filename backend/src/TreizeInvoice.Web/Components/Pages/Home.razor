@page "/app"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDashboardService Dashboard
@inject IInvoiceService InvoiceService

<PageTitle>Übersicht — TreizeInvoice</PageTitle>

@if (_summary is null)
{
    <p>Wird geladen…</p>
}
else
{
    <div class="page-head">
        <div>
            <h1 class="greeting underlined">Guten Tag @FirstName,</h1>
            <p class="greeting-sub">So steht Ihr Unternehmen heute da.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-primary" href="/app/rechnungen/neu">+ Neue Rechnung</a>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_success is not null)
    {
        <div class="alert alert-success">@_success</div>
    }

    @if (!_summary.ProfileComplete)
    {
        <div class="alert alert-warning">
            <strong>Bitte vervollständigen Sie Ihre Unternehmensangaben.</strong>
            Name, Anschrift, Steuernummer und IBAN sind nach §14 UStG Pflicht —
            ohne sie kann keine Rechnung gestellt werden.
            <a href="/app/einstellungen">Zu den Einstellungen</a>
        </div>
    }

    <div class="kpi-grid">
        <div class="kpi">
            <span class="kpi-label">Umsatz berechnet</span>
            <span class="kpi-value">@Euro(_summary.Invoiced)</span>
            <span class="kpi-note">gestellte und bezahlte Rechnungen</span>
            <Sparkline Values="Cumulative(p => p.Invoiced)" Scale="SparkScale" ColorClass="chart-line-expenses" />
        </div>

        <div class="kpi">
            <span class="kpi-label">Eingenommen</span>
            <span class="kpi-value accent-green">@Euro(_summary.Collected)</span>
            <span class="kpi-note">
                @if (_summary.CollectedTrend is { } trend)
                {
                    <span class="@(trend >= 0 ? "trend-up" : "trend-down")">
                        @(trend >= 0 ? "▲" : "▼") @Math.Abs(trend).ToString("0") %
                    </span>
                    <text> ggü. @(_year - 1)</text>
                }
                else
                {
                    <text>Einnahmen im Journal</text>
                }
            </span>
            <Sparkline Values="Cumulative(p => p.Revenue)" Scale="SparkScale" ColorClass="chart-line-revenue" />
        </div>

        <div class="kpi">
            <span class="kpi-label">Ausgaben</span>
            <span class="kpi-value">@Euro(_summary.Expenses)</span>
            <span class="kpi-note">Ergebnis @Euro(_summary.Result)</span>
            <Sparkline Values="Cumulative(p => p.Expenses)" Scale="SparkScale" ColorClass="chart-line-result" />
        </div>

        <div class="kpi">
            <span class="kpi-label">Offene Forderungen</span>
            <span class="kpi-value @(_overdueCount > 0 ? "accent-red" : "")">@Euro(_summary.UnpaidTotal)</span>
            <span class="kpi-note">
                @if (_overdueCount > 0)
                {
                    <span class="trend-down">@_overdueCount überfällig</span>
                }
                else
                {
                    <text>@_summary.Unpaid.Count offene Rechnung(en)</text>
                }
            </span>
        </div>
    </div>

    <div class="panel-grid">
        <section class="panel">
            <div class="panel-head">
                <h2 class="underlined">Finanzüberblick</h2>
                <span class="panel-note">@_year, je Monat</span>
            </div>
            <TrendChart Points="_summary.Monthly" />
        </section>

        <section class="panel">
            <div class="panel-head">
                <h2 class="underlined">Rechnungsstatus</h2>
            </div>
            @if (_summary.StatusCounts.Count == 0)
            {
                <p class="text-muted">Keine Rechnungen in diesem Jahr.</p>
            }
            else
            {
                <StatusDonut Counts="_summary.StatusCounts" />
            }
        </section>
    </div>

    <div class="panel-grid">
        <section class="panel">
            <div class="panel-head">
                <h2 class="underlined">Letzte Rechnungen</h2>
                <a href="/app/rechnungen">Alle anzeigen</a>
            </div>

            @if (_summary.Recent.Count == 0)
            {
                <p class="text-muted">Noch keine Rechnungen.</p>
            }
            else
            {
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Nummer</th>
                            <th>Kunde</th>
                            <th>Datum</th>
                            <th>Status</th>
                            <th class="text-end">Betrag</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in _summary.Recent)
                        {
                            <tr>
                                <td>@(inv.InvoiceNumber ?? "Entwurf")</td>
                                <td>@inv.Client?.Name</td>
                                <td>@inv.InvoiceDate.ToString("dd.MM.yyyy")</td>
                                <td><span class="badge @StatusClass(inv.Status)">@StatusLabel(inv.Status)</span></td>
                                <td class="text-end">@Euro(inv.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="panel">
            <div class="panel-head">
                <h2 class="underlined accent">Schnellzugriff</h2>
            </div>
            <nav class="quick-list">
                <a href="/app/rechnungen/neu">
                    <span class="quick-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 3h9l4 4v14H6z" /><path d="M9.5 12h5M12 9.5v5" />
                        </svg>
                    </span>
                    <span class="quick-text"><strong>Neue Rechnung</strong><em>Rechnung erstellen</em></span>
                    <span class="chev">›</span>
                </a>
                <a href="/app/kunden/neu">
                    <span class="quick-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="3.4" /><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6" />
                        </svg>
                    </span>
                    <span class="quick-text"><strong>Neuer Kunde</strong><em>Kunde anlegen</em></span>
                    <span class="chev">›</span>
                </a>
                <a href="/app/journal">
                    <span class="quick-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 4v11" /><path d="M8 11l4 4 4-4" /><path d="M5 20h14" />
                        </svg>
                    </span>
                    <span class="quick-text"><strong>Ausgabe erfassen</strong><em>Für Ihre EÜR</em></span>
                    <span class="chev">›</span>
                </a>
                <a href="@($"/app/journal/export?year={_year}")">
                    <span class="quick-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h13a1 1 0 0 1 1 1v15H5a1 1 0 0 1-1-1z" /><path d="M8 9h6M8 13h6" />
                        </svg>
                    </span>
                    <span class="quick-text"><strong>Export @_year</strong><em>CSV für die Steuerberatung</em></span>
                    <span class="chev">›</span>
                </a>
                <a href="/app/sicherung">
                    <span class="quick-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 4v10" /><path d="M8 10l4 4 4-4" /><path d="M5 19h14" />
                        </svg>
                    </span>
                    <span class="quick-text"><strong>Sicherung</strong><em>Datenbank und PDF-Archiv</em></span>
                    <span class="chev">›</span>
                </a>
            </nav>
        </section>
    </div>

    @if (_summary.Unpaid.Count > 0)
    {
        <section class="panel">
            <div class="panel-head">
                <h2 class="underlined">Offene Rechnungen</h2>
                <a href="/app/rechnungen">Alle Rechnungen</a>
            </div>
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nummer</th>
                        <th>Kunde</th>
                        <th>Fällig am</th>
                        <th class="text-end">Betrag</th>
                        <th class="text-end">Aktion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in _summary.Unpaid)
                    {
                        var late = inv.DaysOverdue(_today);
                        <tr class="@(late > 0 ? "table-danger" : "")">
                            <td>@inv.InvoiceNumber</td>
                            <td>@inv.Client?.Name</td>
                            <td>
                                @inv.DueDate.ToString("dd.MM.yyyy")
                                @if (late > 0)
                                {
                                    <span class="badge bg-danger ms-1">@late T</span>
                                }
                            </td>
                            <td class="text-end">@Euro(inv.Total)</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-success" @onclick="() => MarkPaidAsync(inv.Id)">
                                    Als bezahlt
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private DashboardSummary? _summary;
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private readonly int _year = DateTime.Today.Year;
    private string? _error;
    private string? _success;
    private int _overdueCount;

    private string FirstName =>
        string.IsNullOrWhiteSpace(_summary?.OwnerName)
            ? ""
            : _summary!.OwnerName.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _summary = await Dashboard.GetAsync(_year, _today);
        _overdueCount = _summary.Unpaid.Count(i => i.DaysOverdue(_today) > 0);
    }

    /// <summary>Échelle partagée par les mini-courbes, pour que leurs hauteurs restent comparables.</summary>
    private decimal SparkScale
    {
        get
        {
            var series = new[]
            {
                Cumulative(p => p.Invoiced),
                Cumulative(p => p.Revenue),
                Cumulative(p => p.Expenses)
            };
            return series.Where(s => s.Count > 0).Select(s => s.Max()).DefaultIfEmpty(0).Max();
        }
    }

    /// <summary>Cumul mois par mois, jusqu'au mois courant : donne une courbe qui progresse.</summary>
    private List<decimal> Cumulative(Func<MonthlyPoint, decimal> selector)
    {
        var result = new List<decimal>();
        decimal running = 0;
        foreach (var p in _summary!.Monthly.Where(p => p.Month <= _today.Month))
        {
            running += selector(p);
            result.Add(running);
        }
        return result;
    }

    private async Task MarkPaidAsync(int id)
    {
        _error = null;
        _success = null;
        try
        {
            await InvoiceService.MarkAsPaidAsync(id);
            _success = "Rechnung als bezahlt markiert. Die Einnahme steht im Journal.";
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        await Load();
    }

    private static string Euro(decimal value) => value.ToString("N2") + " €";

    private static string StatusLabel(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Draft => "Entwurf",
        InvoiceStatus.Issued => "Gestellt",
        InvoiceStatus.Paid => "Bezahlt",
        InvoiceStatus.Cancelled => "Storniert",
        _ => s.ToString()
    };

    private static string StatusClass(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Draft => "bg-secondary",
        InvoiceStatus.Issued => "bg-primary",
        InvoiceStatus.Paid => "bg-success",
        InvoiceStatus.Cancelled => "bg-dark",
        _ => "bg-secondary"
    };
}
