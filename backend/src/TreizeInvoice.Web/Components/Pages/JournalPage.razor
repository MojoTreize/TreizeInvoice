@page "/app/journal"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJournalService JournalService

<PageTitle>Journal — TreizeInvoice</PageTitle>

<div class="page-head">
    <div>
        <h1 class="underlined">Einnahmen / Ausgaben</h1>
        <p class="greeting-sub">
            Grundlage Ihrer EÜR. Einnahmen aus bezahlten Rechnungen entstehen
            automatisch; Ausgaben erfassen Sie hier.
        </p>
    </div>
    <div class="page-actions">
        <select class="form-select w-auto" aria-label="Jahr auswählen" value="@_year" @onchange="OnYearChanged">
            @foreach (var y in _years)
            {
                <option value="@y">@y</option>
            }
        </select>
        <a class="btn" href="@($"/app/journal/export?year={_year}")">CSV-Export @_year</a>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_summary is not null)
{
    <div class="kpi-grid cols-3">
        <div class="kpi">
            <span class="kpi-label">Einnahmen @_year</span>
            <span class="kpi-value accent-green">@_summary.Revenue.ToString("N2") €</span>
        </div>
        <div class="kpi">
            <span class="kpi-label">Ausgaben @_year</span>
            <span class="kpi-value">@_summary.Expenses.ToString("N2") €</span>
        </div>
        <div class="kpi">
            <span class="kpi-label">Ergebnis @_year</span>
            <span class="kpi-value @(_summary.Result < 0 ? "accent-red" : "accent-green")">
                @_summary.Result.ToString("N2") €
            </span>
        </div>
    </div>
}

<section class="panel">
    <div class="panel-head">
        <h2 class="underlined accent">Ausgabe erfassen</h2>
    </div>

    <EditForm Model="_newEntry" OnValidSubmit="AddAsync" FormName="journalEntry">
        <DataAnnotationsValidator />

        <div class="row align-items-end">
            <div class="form-group col-md-2">
                <label for="jDate">Datum</label>
                <InputDate id="jDate" class="form-control" @bind-Value="_newEntry.Date" />
            </div>
            <div class="form-group col-md-2">
                <label for="jType">Art</label>
                <InputSelect id="jType" class="form-select" @bind-Value="_newEntry.Type">
                    <option value="@JournalEntryType.Depense">Ausgabe</option>
                    <option value="@JournalEntryType.Recette">Einnahme</option>
                </InputSelect>
            </div>
            <div class="form-group col-md-2">
                <label for="jCategory">Kategorie</label>
                <InputText id="jCategory" class="form-control" list="categories" @bind-Value="_newEntry.Category" />
                <datalist id="categories">
                    @foreach (var c in SuggestedCategories)
                    {
                        <option value="@c"></option>
                    }
                </datalist>
            </div>
            <div class="form-group col-md-4">
                <label for="jDescription">Beschreibung</label>
                <InputText id="jDescription" class="form-control" @bind-Value="_newEntry.Description" />
                <ValidationMessage For="() => _newEntry.Description" />
            </div>
            <div class="form-group col-md-2">
                <label for="jAmount">Betrag (€)</label>
                <InputNumber id="jAmount" class="form-control text-end" @bind-Value="_newEntry.Amount" />
                <ValidationMessage For="() => _newEntry.Amount" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-2">Hinzufügen</button>
    </EditForm>
</section>

<div class="panel-grid">
<section class="panel">
    <div class="panel-head">
        <h2 class="underlined">Buchungen @_year</h2>
    </div>

@if (_entries is null)
{
    <p>Wird geladen…</p>
}
else if (_entries.Count == 0)
{
    <p class="text-muted">Keine Buchungen für @_year.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Datum</th>
                <th>Art</th>
                <th>Kategorie</th>
                <th>Beschreibung</th>
                <th>Rechnung</th>
                <th class="text-end">Betrag</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in _entries)
            {
                <tr>
                    <td>@e.Date.ToString("dd.MM.yyyy")</td>
                    <td>
                        <span class="badge @(e.Type == JournalEntryType.Recette ? "bg-success" : "bg-secondary")">
                            @(e.Type == JournalEntryType.Recette ? "Einnahme" : "Ausgabe")
                        </span>
                    </td>
                    <td>@e.Category</td>
                    <td>@e.Description</td>
                    <td>@e.Invoice?.InvoiceNumber</td>
                    <td class="text-end">@e.SignedAmount.ToString("N2") €</td>
                    <td class="text-end">
                        @if (e.IsGenerated)
                        {
                            <span class="text-muted small">automatisch</span>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(e.Id)">Löschen</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
</section>

<section class="panel">
    <div class="panel-head">
        <h2 class="underlined accent">Summen je Kategorie</h2>
    </div>

    @if (_summary is { ByCategory.Count: > 0 })
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Kategorie</th>
                    <th class="text-end">Einnahmen</th>
                    <th class="text-end">Ausgaben</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _summary.ByCategory)
                {
                    <tr>
                        <td>@c.Category</td>
                        <td class="text-end">@(c.Revenue == 0 ? "—" : c.Revenue.ToString("N2") + " €")</td>
                        <td class="text-end">@(c.Expenses == 0 ? "—" : c.Expenses.ToString("N2") + " €")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Keine Kategorien für @_year.</p>
    }
</section>
</div>

@code {
    private static readonly string[] SuggestedCategories =
    {
        "Bürobedarf", "Software / Lizenzen", "Hosting / Domain", "Telefon / Internet",
        "Reisekosten", "Fortbildung", "Werbung", "Versicherung", "Gebühren", "Sonstiges"
    };

    private List<JournalEntry>? _entries;
    private List<int> _years = new();
    private JournalSummary? _summary;
    private int _year = DateTime.Today.Year;
    private string? _error;

    private JournalEntry _newEntry = NewEntry();

    protected override async Task OnInitializedAsync()
    {
        _years = await JournalService.GetYearsAsync();
        if (!_years.Contains(_year)) _years.Insert(0, _year);
        await Load();
    }

    private async Task Load()
    {
        _entries = await JournalService.GetForYearAsync(_year);
        _summary = await JournalService.GetSummaryAsync(_year);
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y))
        {
            _year = y;
            await Load();
        }
    }

    private async Task AddAsync()
    {
        _error = null;
        try
        {
            await JournalService.AddManualAsync(_newEntry);
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            return;
        }

        _year = _newEntry.Date.Year;
        _years = await JournalService.GetYearsAsync();
        _newEntry = NewEntry();
        await Load();
    }

    private async Task DeleteAsync(int id)
    {
        _error = null;
        try
        {
            await JournalService.DeleteManualAsync(id);
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        await Load();
    }

    private static JournalEntry NewEntry() => new()
    {
        Date = DateOnly.FromDateTime(DateTime.Today),
        Type = JournalEntryType.Depense
    };
}
