@page "/app/journal"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJournalService JournalService

<PageTitle>Journal — TreizeInvoice</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Journal recettes / dépenses</h1>
    <a class="btn btn-outline-secondary" href="@($"/app/journal/export?year={_year}")">Export CSV @_year</a>
</div>

<p class="text-muted">
    Base de votre EÜR. Les recettes des factures payées y sont ajoutées automatiquement ;
    les dépenses se saisissent ici.
</p>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="mb-3 d-flex align-items-center gap-2">
    <label class="mb-0">Année</label>
    <select class="form-select w-auto" value="@_year" @onchange="OnYearChanged">
        @foreach (var y in _years)
        {
            <option value="@y">@y</option>
        }
    </select>
</div>

@if (_summary is not null)
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card p-3">
                <div class="text-muted small">Recettes @_year</div>
                <div class="fs-4">@_summary.Revenue.ToString("N2") €</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3">
                <div class="text-muted small">Dépenses @_year</div>
                <div class="fs-4">@_summary.Expenses.ToString("N2") €</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3">
                <div class="text-muted small">Résultat @_year</div>
                <div class="fs-4 @(_summary.Result < 0 ? "text-danger" : "text-success")">
                    @_summary.Result.ToString("N2") €
                </div>
            </div>
        </div>
    </div>
}

<h2 class="h5">Ajouter une dépense</h2>

<EditForm Model="_newEntry" OnValidSubmit="AddAsync" FormName="journalEntry" class="mb-4">
    <DataAnnotationsValidator />

    <div class="row align-items-end">
        <div class="form-group col-md-2">
            <label>Date</label>
            <InputDate class="form-control" @bind-Value="_newEntry.Date" />
        </div>
        <div class="form-group col-md-2">
            <label>Type</label>
            <InputSelect class="form-select" @bind-Value="_newEntry.Type">
                <option value="@JournalEntryType.Depense">Dépense</option>
                <option value="@JournalEntryType.Recette">Recette</option>
            </InputSelect>
        </div>
        <div class="form-group col-md-2">
            <label>Catégorie</label>
            <InputText class="form-control" list="categories" @bind-Value="_newEntry.Category" />
            <datalist id="categories">
                @foreach (var c in SuggestedCategories)
                {
                    <option value="@c"></option>
                }
            </datalist>
        </div>
        <div class="form-group col-md-4">
            <label>Description</label>
            <InputText class="form-control" @bind-Value="_newEntry.Description" />
            <ValidationMessage For="() => _newEntry.Description" />
        </div>
        <div class="form-group col-md-2">
            <label>Montant (€)</label>
            <InputNumber class="form-control text-end" @bind-Value="_newEntry.Amount" />
            <ValidationMessage For="() => _newEntry.Amount" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Ajouter</button>
</EditForm>

<h2 class="h5">Écritures @_year</h2>

@if (_entries is null)
{
    <p>Chargement…</p>
}
else if (_entries.Count == 0)
{
    <div class="alert alert-secondary">Aucune écriture pour @_year.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Catégorie</th>
                <th>Description</th>
                <th>Facture</th>
                <th class="text-end">Montant</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in _entries)
            {
                <tr>
                    <td>@e.Date.ToString("dd.MM.yyyy")</td>
                    <td>
                        <span class="badge @(e.Type == JournalEntryType.Recette ? "bg-success" : "bg-secondary")">
                            @(e.Type == JournalEntryType.Recette ? "Recette" : "Dépense")
                        </span>
                    </td>
                    <td>@e.Category</td>
                    <td>@e.Description</td>
                    <td>@e.Invoice?.InvoiceNumber</td>
                    <td class="text-end">@e.SignedAmount.ToString("N2") €</td>
                    <td class="text-end">
                        @if (e.IsGenerated)
                        {
                            <span class="text-muted small">automatique</span>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(e.Id)">Supprimer</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_summary is { ByCategory.Count: > 0 })
{
    <h2 class="h5 mt-4">Totaux par catégorie</h2>
    <table class="table table-sm w-auto">
        <thead>
            <tr>
                <th>Catégorie</th>
                <th class="text-end">Recettes</th>
                <th class="text-end">Dépenses</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _summary.ByCategory)
            {
                <tr>
                    <td>@c.Category</td>
                    <td class="text-end">@(c.Revenue == 0 ? "—" : c.Revenue.ToString("N2") + " €")</td>
                    <td class="text-end">@(c.Expenses == 0 ? "—" : c.Expenses.ToString("N2") + " €")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private static readonly string[] SuggestedCategories =
    {
        "Bürobedarf", "Software / Lizenzen", "Hosting / Domain", "Telefon / Internet",
        "Reisekosten", "Fortbildung", "Werbung", "Versicherung", "Gebühren", "Sonstiges"
    };

    private List<JournalEntry>? _entries;
    private List<int> _years = new();
    private JournalSummary? _summary;
    private int _year = DateTime.Today.Year;
    private string? _error;

    private JournalEntry _newEntry = NewEntry();

    protected override async Task OnInitializedAsync()
    {
        _years = await JournalService.GetYearsAsync();
        if (!_years.Contains(_year)) _years.Insert(0, _year);
        await Load();
    }

    private async Task Load()
    {
        _entries = await JournalService.GetForYearAsync(_year);
        _summary = await JournalService.GetSummaryAsync(_year);
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y))
        {
            _year = y;
            await Load();
        }
    }

    private async Task AddAsync()
    {
        _error = null;
        try
        {
            await JournalService.AddManualAsync(_newEntry);
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            return;
        }

        _year = _newEntry.Date.Year;
        _years = await JournalService.GetYearsAsync();
        _newEntry = NewEntry();
        await Load();
    }

    private async Task DeleteAsync(int id)
    {
        _error = null;
        try
        {
            await JournalService.DeleteManualAsync(id);
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        await Load();
    }

    private static JournalEntry NewEntry() => new()
    {
        Date = DateOnly.FromDateTime(DateTime.Today),
        Type = JournalEntryType.Depense
    };
}
