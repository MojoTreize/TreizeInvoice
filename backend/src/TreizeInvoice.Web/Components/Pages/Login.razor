@page "/login"
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IAuthService AuthService
@inject LoginThrottle Throttle
@inject NavigationManager Nav

<PageTitle>Anmelden — TreizeInvoice</PageTitle>

<svg class="auth-logo" viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="0" y="0" width="96" height="96" rx="14" fill="#2946B8" />
    <path d="M 16 31 L 31 14 H 37 V 84 H 16 Z" fill="#F3EDE2" />
    <path d="M 16 31 L 31 14 V 31 Z" fill="#1C3187" />
    <rect x="21" y="71" width="11" height="5" fill="#1C3187" />
    <path d="M 49 19.5 H 63 A 14.5 14.5 0 0 1 63 48.5 H 59 M 59 48.5 H 63 A 15 15 0 0 1 63 78.5 H 49"
          fill="none" stroke="#FFFFFF" stroke-width="11" stroke-linejoin="round" />
</svg>

<h1 class="auth-title">TreizeInvoice</h1>
<p class="auth-subtitle">Anmeldung zu Ihrer Rechnungsstellung</p>

<EditForm Model="Input" OnValidSubmit="LoginAsync" FormName="login" method="post">
    <DataAnnotationsValidator />

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <div class="form-group">
        <label for="username">Benutzername</label>
        <InputText id="username" class="form-control" @bind-Value="Input.Username" autocomplete="username" />
        <ValidationMessage For="() => Input.Username" />
    </div>

    <div class="form-group">
        <label for="password">Passwort</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="Input.Password" autocomplete="current-password" />
        <ValidationMessage For="() => Input.Password" />
    </div>

    <button type="submit" class="btn btn-primary w-100">Anmelden</button>
</EditForm>

<p class="auth-footer">
    Noch kein Konto? <a href="/register">Beta-Zugang anfragen</a><br />
    <a href="/">Zurück zur Startseite</a>
</p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? _error;

    private async Task LoginAsync()
    {
        if (Throttle.RemainingLockout(Input.Username) is { } wait)
        {
            _error = $"Zu viele Fehlversuche. Bitte warten Sie {Math.Ceiling(wait.TotalMinutes)} Minuten.";
            return;
        }

        var user = await AuthService.ValidateCredentialsAsync(Input.Username, Input.Password);
        if (user is null)
        {
            Throttle.RegisterFailure(Input.Username);
            _error = "Benutzername oder Passwort ist falsch.";
            return;
        }

        Throttle.RegisterSuccess(Input.Username);

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, user.Id.ToString()),
            new(ClaimTypes.Name, user.Username)
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity));

        Nav.NavigateTo(SafeReturnUrl());
    }

    /// <summary>
    /// ReturnUrl vient de l'URL : sans ce filtre, un lien /login?ReturnUrl=https://…
    /// renverrait l'utilisatrice sur un site tiers juste après l'authentification.
    /// </summary>
    private string SafeReturnUrl() =>
        !string.IsNullOrWhiteSpace(ReturnUrl)
        && ReturnUrl.StartsWith('/')
        && !ReturnUrl.StartsWith("//")
        && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : "/app";

    public class LoginModel
    {
        [Required(ErrorMessage = "Bitte geben Sie Ihren Benutzernamen an.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Bitte geben Sie Ihr Passwort an.")]
        public string Password { get; set; } = string.Empty;
    }
}
