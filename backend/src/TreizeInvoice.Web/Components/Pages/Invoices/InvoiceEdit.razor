@page "/app/rechnungen/neu"
@page "/app/rechnungen/{Id:int}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IInvoiceService InvoiceService
@inject IClientService ClientService
@inject IBusinessProfileService ProfileService
@inject IInvoiceTotalsCalculator Totals
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Neue Rechnung" : "Entwurf bearbeiten") — TreizeInvoice</PageTitle>

<h1 class="underlined">@(IsNew ? "Neue Rechnung" : "Entwurf bearbeiten")</h1>

<div class="editor-grid">
<section class="panel">
@if (_locked)
{
    <div class="alert alert-warning">
        Diese Rechnung ist bereits gestellt und kann nach den GoBD-Grundsätzen
        nicht mehr geändert werden.
        <a href="/app/rechnungen">Zurück zur Übersicht</a>
    </div>
}
else if (_invoice is null || _clients is null)
{
    <p>Wird geladen…</p>
}
else
{
    <EditForm Model="_invoice" OnValidSubmit="SaveAsync" FormName="invoice">
        <DataAnnotationsValidator />

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        <div class="row">
            <div class="form-group col-md-6">
                <label for="invClient">Kunde *</label>
                <InputSelect id="invClient" class="form-select" @bind-Value="_invoice.ClientId"
                             @bind-Value:after="StateHasChanged">
                    <option value="0">— Kunde wählen —</option>
                    @foreach (var c in _clients)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _invoice.ClientId" />
            </div>
            <div class="form-group col-md-3">
                <label for="invDate">Rechnungsdatum *</label>
                <InputDate id="invDate" class="form-control" @bind-Value="_invoice.InvoiceDate"
                           @bind-Value:after="StateHasChanged" />
            </div>
            <div class="form-group col-md-3">
                <label for="invTerm">Zahlungsziel (Tage)</label>
                <InputNumber id="invTerm" class="form-control" @bind-Value="_invoice.PaymentTermDays"
                             @bind-Value:after="StateHasChanged" />
                <ValidationMessage For="() => _invoice.PaymentTermDays" />
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-4">
                <label for="invService">Leistungsdatum</label>
                <InputDate id="invService" class="form-control" @bind-Value="_invoice.ServiceDate"
                           @bind-Value:after="StateHasChanged" />
            </div>
            <div class="form-group col-md-8">
                <label for="invPeriod">Leistungszeitraum (Freitext)</label>
                @* InputText ne permet pas de choisir l'événement : sans oninput,
                   l'aperçu n'avancerait qu'à la sortie du champ. *@
                <input id="invPeriod" class="form-control" value="@_invoice.ServicePeriod"
                       @oninput="e => _invoice.ServicePeriod = e.Value?.ToString()"
                       placeholder="z. B. 01.03.2026 – 31.03.2026" />
            </div>
        </div>

        <h2 class="mt-4">Positionen</h2>

        @if (_items.Count == 0)
        {
            <p class="text-muted">Bitte fügen Sie mindestens eine Position hinzu.</p>
        }
        else
        {
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width:50%">Beschreibung</th>
                        <th style="width:12%" class="text-end">Menge</th>
                        <th style="width:18%" class="text-end">Einzelpreis (€)</th>
                        <th style="width:15%" class="text-end">Betrag</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr @key="item">
                            <td>
                                <input class="form-control" aria-label="Beschreibung der Position"
                                       value="@item.Description"
                                       @oninput="e => item.Description = e.Value?.ToString() ?? string.Empty" />
                            </td>
                            <td>
                                <InputNumber class="form-control text-end" aria-label="Menge" @bind-Value="item.Quantity"
                                             @bind-Value:after="StateHasChanged" />
                            </td>
                            <td>
                                <InputNumber class="form-control text-end" aria-label="Einzelpreis in Euro" @bind-Value="item.UnitPrice"
                                             @bind-Value:after="StateHasChanged" />
                            </td>
                            <td class="text-end">@item.LineTotal.ToString("N2") €</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        title="Position entfernen" aria-label="Position entfernen"
                                        @onclick="() => RemoveItem(item)">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Gesamtbetrag</th>
                        <th class="text-end">@CurrentTotal.ToString("N2") €</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        }

        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddItem">+ Position hinzufügen</button>

        <div class="form-group mt-4">
            <label for="invNotes">Anmerkungen</label>
            <textarea id="invNotes" class="form-control" rows="2" value="@_invoice.Notes"
                      @oninput="e => _invoice.Notes = e.Value?.ToString()"></textarea>
        </div>

        <div class="save-as">
            <div class="form-group">
                <label for="saveAs">Beim Speichern</label>
                <select id="saveAs" class="form-select" value="@_saveAs" @onchange="OnSaveAsChanged">
                    <option value="@nameof(SaveMode.Draft)">Als Entwurf ablegen</option>
                    <option value="@nameof(SaveMode.Issue)">Ausstellen (Nummer vergeben, PDF archivieren)</option>
                    <option value="@nameof(SaveMode.IssueAndPay)">Ausstellen und sofort als bezahlt buchen</option>
                </select>
            </div>

            <p class="save-as-note">
                @switch (_saveAs)
                {
                    case SaveMode.Draft:
                        <text>
                            Der Entwurf bekommt noch keine Rechnungsnummer und bleibt frei
                            änderbar. Nummern werden erst beim Ausstellen vergeben — so
                            entstehen keine Lücken in der Nummernfolge.
                        </text>
                        break;
                    case SaveMode.Issue:
                        <text>
                            Die Rechnung erhält ihre Nummer, das PDF wird archiviert und der
                            Beleg ist damit festgeschrieben: Änderungen sind danach nur noch
                            per Stornorechnung möglich (GoBD).
                        </text>
                        break;
                    default:
                        <text>
                            Zusätzlich wird die Zahlung sofort im Journal als Einnahme
                            gebucht — für Leistungen, die direkt bezahlt werden.
                        </text>
                        break;
                }
            </p>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary" disabled="@_saving">
                @(_saving ? "Wird gespeichert…" : SaveLabel)
            </button>
            <a class="btn" href="/app/rechnungen">Abbrechen</a>
        </div>
    </EditForm>
}
</section>

@if (!_locked && _invoice is not null && _clients is not null)
{
    <aside class="preview-pane">
        <div class="preview-head">
            <h2>Vorschau</h2>
            <span class="preview-note">So wird das PDF aussehen</span>
        </div>

        <InvoicePreview Invoice="_invoice"
                        Profile="_profile"
                        Client="SelectedClient"
                        Items="_items"
                        Total="CurrentTotal" />

        @if (_profile is not null && MissingProfileFields.Count > 0)
        {
            <p class="preview-warning">
                Für eine gültige Rechnung fehlt noch: @string.Join(", ", MissingProfileFields).
                <a href="/app/einstellungen">In den Einstellungen ergänzen</a>
            </p>
        }
    </aside>
}
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private enum SaveMode { Draft, Issue, IssueAndPay }

    private Invoice? _invoice;
    private List<Client>? _clients;
    private BusinessProfile? _profile;
    private readonly List<InvoiceItem> _items = new();
    private string? _error;
    private bool _locked;
    private SaveMode _saveAs = SaveMode.Draft;
    private bool _saving;

    private bool IsNew => Id is null;

    private Client? SelectedClient => _clients?.FirstOrDefault(c => c.Id == _invoice?.ClientId);

    /// <summary>Mêmes exigences que le contrôle à l'émission, mais signalées dès la saisie.</summary>
    private List<string> MissingProfileFields
    {
        get
        {
            var missing = new List<string>();
            if (_profile is null) return missing;
            if (string.IsNullOrWhiteSpace(_profile.FullName)) missing.Add("Name");
            if (string.IsNullOrWhiteSpace(_profile.Address)) missing.Add("Anschrift");
            if (string.IsNullOrWhiteSpace(_profile.Steuernummer)) missing.Add("Steuernummer");
            if (string.IsNullOrWhiteSpace(_profile.Iban)) missing.Add("IBAN");
            return missing;
        }
    }

    private string SaveLabel => _saveAs switch
    {
        SaveMode.Issue => "Speichern und ausstellen",
        SaveMode.IssueAndPay => "Ausstellen und als bezahlt buchen",
        _ => "Als Entwurf speichern"
    };

    private void OnSaveAsChanged(ChangeEventArgs e) =>
        _saveAs = Enum.TryParse<SaveMode>(e.Value?.ToString(), out var mode) ? mode : SaveMode.Draft;

    // Le calcul passe par le service pour rester cohérent avec le PDF (TVA ajoutable plus tard).
    private decimal CurrentTotal
    {
        get
        {
            if (_invoice is null) return 0m;
            _invoice.Items = _items;
            return Totals.Calculate(_invoice).Gross;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _clients = await ClientService.SearchAsync();
        _profile = await ProfileService.GetAsync();

        if (IsNew)
        {
            _invoice = new Invoice { InvoiceDate = DateOnly.FromDateTime(DateTime.Today) };
            _items.Clear();
            _items.Add(new InvoiceItem());
            return;
        }

        var loaded = await InvoiceService.GetAsync(Id!.Value);
        if (loaded is null)
        {
            Nav.NavigateTo("/app/rechnungen");
            return;
        }

        if (loaded.Status != InvoiceStatus.Draft)
        {
            _locked = true;
            return;
        }

        _invoice = loaded;
        _items.Clear();
        _items.AddRange(loaded.Items);
    }

    private void AddItem() => _items.Add(new InvoiceItem());

    private void RemoveItem(InvoiceItem item) => _items.Remove(item);

    private async Task SaveAsync()
    {
        if (_invoice is null) return;
        _error = null;

        if (_items.Count == 0 || _items.All(i => string.IsNullOrWhiteSpace(i.Description)))
        {
            _error = "Die Rechnung braucht mindestens eine beschriebene Position.";
            return;
        }

        if (_items.Any(i => i.Quantity <= 0 || i.UnitPrice <= 0))
        {
            _error = "Menge und Einzelpreis müssen bei jeder Position größer als 0 sein.";
            return;
        }

        _invoice.Items = _items;
        _saving = true;

        var id = _invoice.Id;
        try
        {
            if (IsNew)
                id = (await InvoiceService.CreateDraftAsync(_invoice)).Id;
            else
                await InvoiceService.UpdateDraftAsync(_invoice);

            if (_saveAs is SaveMode.Issue or SaveMode.IssueAndPay)
            {
                var issued = await InvoiceService.IssueAsync(id);
                if (_saveAs == SaveMode.IssueAndPay)
                    await InvoiceService.MarkAsPaidAsync(issued.Id);
            }
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _saving = false;

            // Le brouillon est enregistré même si l'émission échoue. Sans cette
            // redirection, un second envoi créerait un doublon.
            if (IsNew && id != 0)
                Nav.NavigateTo($"/app/rechnungen/{id}");
            return;
        }

        Nav.NavigateTo("/app/rechnungen");
    }
}
