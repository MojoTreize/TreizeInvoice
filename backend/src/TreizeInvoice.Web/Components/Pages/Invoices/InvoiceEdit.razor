@page "/app/factures/nouvelle"
@page "/app/factures/{Id:int}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IInvoiceService InvoiceService
@inject IClientService ClientService
@inject IInvoiceTotalsCalculator Totals
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Nouvelle facture" : "Modifier la facture") — TreizeInvoice</PageTitle>

<h1>@(IsNew ? "Nouvelle facture" : "Modifier le brouillon")</h1>

@if (_locked)
{
    <div class="alert alert-warning">
        Cette facture est émise : elle ne peut plus être modifiée (immutabilité GoBD).
        <a href="/app/factures">Retour à la liste</a>
    </div>
}
else if (_invoice is null || _clients is null)
{
    <p>Chargement…</p>
}
else
{
    <EditForm Model="_invoice" OnValidSubmit="SaveAsync" FormName="invoice">
        <DataAnnotationsValidator />

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        <div class="row">
            <div class="form-group col-md-6">
                <label>Client *</label>
                <InputSelect class="form-select" @bind-Value="_invoice.ClientId">
                    <option value="0">— Choisir un client —</option>
                    @foreach (var c in _clients)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _invoice.ClientId" />
            </div>
            <div class="form-group col-md-3">
                <label>Date de facture *</label>
                <InputDate class="form-control" @bind-Value="_invoice.InvoiceDate" />
            </div>
            <div class="form-group col-md-3">
                <label>Délai de paiement (jours)</label>
                <InputNumber class="form-control" @bind-Value="_invoice.PaymentTermDays" />
                <ValidationMessage For="() => _invoice.PaymentTermDays" />
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-4">
                <label>Date de prestation</label>
                <InputDate class="form-control" @bind-Value="_invoice.ServiceDate" />
            </div>
            <div class="form-group col-md-8">
                <label>Période de prestation (texte libre)</label>
                <InputText class="form-control" @bind-Value="_invoice.ServicePeriod"
                           placeholder="ex. 01.03.2026 – 31.03.2026" />
            </div>
        </div>

        <h2 class="mt-4 h5">Lignes</h2>

        @if (_items.Count == 0)
        {
            <div class="alert alert-secondary">Ajoutez au moins une ligne.</div>
        }
        else
        {
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width:50%">Description</th>
                        <th style="width:12%" class="text-end">Quantité</th>
                        <th style="width:18%" class="text-end">Prix unitaire (€)</th>
                        <th style="width:15%" class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr @key="item">
                            <td>
                                <InputText class="form-control" @bind-Value="item.Description" />
                            </td>
                            <td>
                                <InputNumber class="form-control text-end" @bind-Value="item.Quantity"
                                             @bind-Value:after="StateHasChanged" />
                            </td>
                            <td>
                                <InputNumber class="form-control text-end" @bind-Value="item.UnitPrice"
                                             @bind-Value:after="StateHasChanged" />
                            </td>
                            <td class="text-end">@item.LineTotal.ToString("N2") €</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="() => RemoveItem(item)">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Total</th>
                        <th class="text-end">@CurrentTotal.ToString("N2") €</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        }

        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddItem">+ Ajouter une ligne</button>

        <div class="form-group mt-4">
            <label>Notes</label>
            <InputTextArea class="form-control" rows="2" @bind-Value="_invoice.Notes" />
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Enregistrer le brouillon</button>
            <a class="btn btn-secondary" href="/app/factures">Annuler</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Invoice? _invoice;
    private List<Client>? _clients;
    private readonly List<InvoiceItem> _items = new();
    private string? _error;
    private bool _locked;

    private bool IsNew => Id is null;

    // Le calcul passe par le service pour rester cohérent avec le PDF (TVA ajoutable plus tard).
    private decimal CurrentTotal
    {
        get
        {
            if (_invoice is null) return 0m;
            _invoice.Items = _items;
            return Totals.Calculate(_invoice).Gross;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _clients = await ClientService.SearchAsync();

        if (IsNew)
        {
            _invoice = new Invoice { InvoiceDate = DateOnly.FromDateTime(DateTime.Today) };
            _items.Clear();
            _items.Add(new InvoiceItem());
            return;
        }

        var loaded = await InvoiceService.GetAsync(Id!.Value);
        if (loaded is null)
        {
            Nav.NavigateTo("/app/factures");
            return;
        }

        if (loaded.Status != InvoiceStatus.Draft)
        {
            _locked = true;
            return;
        }

        _invoice = loaded;
        _items.Clear();
        _items.AddRange(loaded.Items);
    }

    private void AddItem() => _items.Add(new InvoiceItem());

    private void RemoveItem(InvoiceItem item) => _items.Remove(item);

    private async Task SaveAsync()
    {
        if (_invoice is null) return;
        _error = null;

        if (_items.Count == 0 || _items.All(i => string.IsNullOrWhiteSpace(i.Description)))
        {
            _error = "La facture doit contenir au moins une ligne décrite.";
            return;
        }

        if (_items.Any(i => i.Quantity <= 0 || i.UnitPrice <= 0))
        {
            _error = "Chaque ligne doit avoir une quantité et un prix unitaire supérieurs à 0.";
            return;
        }

        _invoice.Items = _items;

        try
        {
            if (IsNew)
                await InvoiceService.CreateDraftAsync(_invoice);
            else
                await InvoiceService.UpdateDraftAsync(_invoice);
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            return;
        }

        Nav.NavigateTo("/app/factures");
    }
}
