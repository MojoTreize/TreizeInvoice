@page "/app/factures"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IInvoiceService InvoiceService
@inject NavigationManager Nav

<PageTitle>Factures — TreizeInvoice</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Factures</h1>
    <a class="btn btn-primary" href="/app/factures/nouvelle">+ Nouvelle facture</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_invoices is null)
{
    <p>Chargement…</p>
}
else if (_invoices.Count == 0)
{
    <div class="alert alert-secondary">Aucune facture pour l'instant.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Numéro</th>
                <th>Client</th>
                <th>Date</th>
                <th>Statut</th>
                <th class="text-end">Total</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in _invoices)
            {
                <tr>
                    <td>@(inv.InvoiceNumber ?? "—")</td>
                    <td>@inv.Client?.Name</td>
                    <td>@inv.InvoiceDate.ToString("dd.MM.yyyy")</td>
                    <td><span class="badge @StatusClass(inv.Status)">@StatusLabel(inv.Status)</span></td>
                    <td class="text-end">@inv.Total.ToString("N2") €</td>
                    <td class="text-end">
                        @if (inv.Status == InvoiceStatus.Draft)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="@($"/app/factures/{inv.Id}")">Modifier</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _pendingDelete = inv">Supprimer</button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => DuplicateAsync(inv.Id)">Dupliquer</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_pendingDelete is not null)
{
    <div class="alert alert-warning">
        <p>Supprimer définitivement ce brouillon ?</p>
        <button class="btn btn-sm btn-danger" @onclick="ConfirmDeleteAsync">Confirmer</button>
        <button class="btn btn-sm btn-secondary" @onclick="() => _pendingDelete = null">Annuler</button>
    </div>
}

@code {
    private List<Invoice>? _invoices;
    private Invoice? _pendingDelete;
    private string? _error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _invoices = await InvoiceService.GetAllAsync();

    private async Task DuplicateAsync(int id)
    {
        var copy = await InvoiceService.DuplicateAsDraftAsync(id);
        Nav.NavigateTo($"/app/factures/{copy.Id}");
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is null) return;
        _error = null;
        try
        {
            await InvoiceService.DeleteDraftAsync(_pendingDelete.Id);
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        _pendingDelete = null;
        await Load();
    }

    private static string StatusLabel(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Draft => "Brouillon",
        InvoiceStatus.Issued => "Émise",
        InvoiceStatus.Paid => "Payée",
        InvoiceStatus.Cancelled => "Annulée",
        _ => s.ToString()
    };

    private static string StatusClass(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Draft => "bg-secondary",
        InvoiceStatus.Issued => "bg-primary",
        InvoiceStatus.Paid => "bg-success",
        InvoiceStatus.Cancelled => "bg-dark",
        _ => "bg-secondary"
    };
}
