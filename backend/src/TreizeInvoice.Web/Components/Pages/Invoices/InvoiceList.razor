@page "/app/rechnungen"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IInvoiceService InvoiceService
@inject NavigationManager Nav

<PageTitle>Rechnungen — TreizeInvoice</PageTitle>

<div class="page-head">
    <div>
        <h1 class="underlined">Rechnungen</h1>
        <p class="greeting-sub">Eine gestellte Rechnung ist festgeschrieben — Korrekturen nur per Storno.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/app/rechnungen/neu">+ Neue Rechnung</a>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_success is not null)
{
    <div class="alert alert-success">@_success</div>
}

<section class="panel filters">
    <div class="filter-row">
        <div class="form-group grow">
            <label for="fText">Suche</label>
            <input id="fText" class="form-control" type="search" placeholder="Rechnungsnummer oder Kunde"
                   value="@_text" @oninput="e => ApplyText(e.Value?.ToString())" />
        </div>
        <div class="form-group">
            <label for="fStatus">Status</label>
            <select id="fStatus" class="form-select" value="@(_status?.ToString() ?? "")"
                    @onchange="e => ApplyStatus(e.Value?.ToString())">
                <option value="">Alle</option>
                <option value="@nameof(InvoiceStatus.Draft)">Entwurf</option>
                <option value="@nameof(InvoiceStatus.Issued)">Gestellt</option>
                <option value="@nameof(InvoiceStatus.Paid)">Bezahlt</option>
                <option value="@nameof(InvoiceStatus.Cancelled)">Storniert</option>
            </select>
        </div>
        <div class="form-group">
            <label for="fFrom">Datum von</label>
            <input id="fFrom" class="form-control" type="date"
                   value="@_from?.ToString("yyyy-MM-dd")" @onchange="e => ApplyFrom(e.Value?.ToString())" />
        </div>
        <div class="form-group">
            <label for="fTo">bis</label>
            <input id="fTo" class="form-control" type="date"
                   value="@_to?.ToString("yyyy-MM-dd")" @onchange="e => ApplyTo(e.Value?.ToString())" />
        </div>
        <div class="form-group narrow">
            <label for="fMin">Betrag ab</label>
            <input id="fMin" class="form-control text-end" type="number" step="0.01" placeholder="0,00"
                   value="@_min" @onchange="e => ApplyMin(e.Value?.ToString())" />
        </div>
        <div class="form-group narrow">
            <label for="fMax">bis</label>
            <input id="fMax" class="form-control text-end" type="number" step="0.01" placeholder="—"
                   value="@_max" @onchange="e => ApplyMax(e.Value?.ToString())" />
        </div>
        @if (HasFilter)
        {
            <button type="button" class="btn btn-sm reset" @onclick="ResetFilters">Filter zurücksetzen</button>
        }
    </div>
</section>

@if (_page is null)
{
    <p>Wird geladen…</p>
}
else if (_page.TotalCount == 0)
{
    <section class="panel">
        <p class="text-muted mb-0">
            @(HasFilter ? "Keine Rechnung passt zu diesen Filtern." : "Noch keine Rechnungen.")
        </p>
    </section>
}
else
{
    <section class="panel">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th><SortButton Column="InvoiceSort.Number" Current="_sort" Descending="_desc" OnSort="SortBy">Nummer</SortButton></th>
                <th><SortButton Column="InvoiceSort.Client" Current="_sort" Descending="_desc" OnSort="SortBy">Kunde</SortButton></th>
                <th><SortButton Column="InvoiceSort.Date" Current="_sort" Descending="_desc" OnSort="SortBy">Datum</SortButton></th>
                <th><SortButton Column="InvoiceSort.Status" Current="_sort" Descending="_desc" OnSort="SortBy">Status</SortButton></th>
                <th class="text-end"><SortButton Column="InvoiceSort.Amount" Current="_sort" Descending="_desc" OnSort="SortBy">Betrag</SortButton></th>
                <th class="text-end">Aktionen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in _page.Items)
            {
                <tr>
                    <td>
                        @(inv.InvoiceNumber ?? "—")
                        @if (inv.CancelsInvoice is not null)
                        {
                            <br />
                            <small class="text-muted">Storno zu @inv.CancelsInvoice.InvoiceNumber</small>
                        }
                    </td>
                    <td>@inv.Client?.Name</td>
                    <td>@inv.InvoiceDate.ToString("dd.MM.yyyy")</td>
                    <td><span class="badge @StatusClass(inv.Status)">@StatusLabel(inv.Status)</span></td>
                    <td class="text-end">@inv.Total.ToString("N2") €</td>
                    <td class="text-end">
                        @if (inv.Status == InvoiceStatus.Draft)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="@($"/app/rechnungen/{inv.Id}")">Bearbeiten</a>
                            <button class="btn btn-sm btn-success" @onclick="() => _pendingIssue = inv">Ausstellen</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _pendingDelete = inv">Löschen</button>
                        }
                        else
                        {
                            <a class="btn btn-sm" href="@($"/app/rechnungen/{inv.Id}/pdf")" target="_blank">PDF</a>
                        }
                        @if (inv.Status == InvoiceStatus.Issued && inv.CancelsInvoiceId is null)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => MarkPaidAsync(inv.Id)">Als bezahlt</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => _pendingCorrect = inv">Korrigieren</button>
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => _pendingCancel = inv">Stornieren</button>
                        }
                        <button class="btn btn-sm" @onclick="() => DuplicateAsync(inv.Id)">Duplizieren</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </section>

    <div class="pager">
        <span>
            @($"{_page.TotalCount} Rechnung{(_page.TotalCount == 1 ? "" : "en")}")
            @if (_page.PageCount > 1)
            {
                <text> · Seite @_page.Page von @_page.PageCount</text>
            }
        </span>
        @if (_page.PageCount > 1)
        {
            <span class="pager-buttons">
                <button class="btn btn-sm" disabled="@(!_page.HasPrevious)" @onclick="() => GoToPage(_page.Page - 1)">Zurück</button>
                <button class="btn btn-sm" disabled="@(!_page.HasNext)" @onclick="() => GoToPage(_page.Page + 1)">Weiter</button>
            </span>
        }
    </div>
}

@if (_pendingCorrect is not null)
{
    <div class="alert alert-warning">
        <p class="mb-2">
            <strong>Rechnung @_pendingCorrect.InvoiceNumber korrigieren?</strong><br />
            Eine gestellte Rechnung lässt sich nicht bearbeiten — das verlangen die
            GoBD. TreizeInvoice erledigt die zulässige Korrektur in einem Schritt:
            es wird eine Stornorechnung erstellt und anschließend ein neuer Entwurf
            mit denselben Positionen geöffnet, den Sie berichtigen und neu ausstellen.
        </p>
        <button class="btn btn-sm btn-primary" @onclick="ConfirmCorrectAsync" disabled="@_working">
            @(_working ? "Wird vorbereitet…" : "Stornieren und neu erfassen")
        </button>
        <button class="btn btn-sm" @onclick="() => _pendingCorrect = null">Abbrechen</button>
    </div>
}

@if (_pendingIssue is not null)
{
    <div class="alert alert-warning">
        <p class="mb-2">
            <strong>Rechnung endgültig ausstellen?</strong><br />
            Sie erhält eine Rechnungsnummer und das PDF wird archiviert. Nach den
            GoBD-Grundsätzen kann sie danach weder geändert noch gelöscht werden —
            eine Korrektur ist nur über eine Stornorechnung möglich.
        </p>
        <button class="btn btn-sm btn-success" @onclick="ConfirmIssueAsync" disabled="@_issuing">
            @(_issuing ? "Wird ausgestellt…" : "Ausstellen")
        </button>
        <button class="btn btn-sm" @onclick="() => _pendingIssue = null">Abbrechen</button>
    </div>
}

@if (_pendingCancel is not null)
{
    <div class="alert alert-warning">
        <p class="mb-2">
            <strong>Rechnung @_pendingCancel.InvoiceNumber stornieren?</strong><br />
            Es wird eine Stornorechnung mit negativen Beträgen und eigener Nummer
            erstellt. Die Ursprungsrechnung wird als storniert gekennzeichnet.
            Anschließend können Sie eine korrigierte Rechnung stellen.
        </p>
        <button class="btn btn-sm btn-outline-warning" @onclick="ConfirmCancelAsync" disabled="@_working">
            @(_working ? "Wird storniert…" : "Storno erstellen")
        </button>
        <button class="btn btn-sm" @onclick="() => _pendingCancel = null">Zurück</button>
    </div>
}

@if (_pendingDelete is not null)
{
    <div class="alert alert-warning">
        <p>Diesen Entwurf endgültig löschen?</p>
        <button class="btn btn-sm btn-danger" @onclick="ConfirmDeleteAsync">Löschen</button>
        <button class="btn btn-sm" @onclick="() => _pendingDelete = null">Abbrechen</button>
    </div>
}

@code {
    private InvoicePage<Invoice>? _page;
    private Invoice? _pendingDelete;
    private Invoice? _pendingIssue;
    private Invoice? _pendingCancel;
    private Invoice? _pendingCorrect;
    private bool _issuing;
    private bool _working;
    private string? _error;
    private string? _success;

    private string? _text;
    private InvoiceStatus? _status;
    private DateOnly? _from;
    private DateOnly? _to;
    private decimal? _min;
    private decimal? _max;
    private InvoiceSort _sort = InvoiceSort.Date;
    private bool _desc = true;
    private int _pageNumber = 1;

    // La frappe déclenche une requête à chaque touche : sans ce jeton, une réponse
    // lente écraserait le résultat d'une saisie plus récente.
    private CancellationTokenSource? _debounce;

    private bool HasFilter =>
        !string.IsNullOrWhiteSpace(_text) || _status is not null ||
        _from is not null || _to is not null || _min is not null || _max is not null;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _page = await InvoiceService.SearchAsync(new InvoiceQuery(
            Text: _text, Status: _status, From: _from, To: _to,
            MinAmount: _min, MaxAmount: _max,
            Sort: _sort, Descending: _desc, Page: _pageNumber));
    }

    private async Task ReloadFromFirstPage()
    {
        _pageNumber = 1;
        await Load();
    }

    private async Task ApplyText(string? value)
    {
        _text = value;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            await ReloadFromFirstPage();
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Une frappe plus récente a pris le relais.
        }
    }

    private async Task ApplyStatus(string? value)
    {
        _status = Enum.TryParse<InvoiceStatus>(value, out var s) ? s : null;
        await ReloadFromFirstPage();
    }

    private async Task ApplyFrom(string? value)
    {
        _from = DateOnly.TryParse(value, out var d) ? d : null;
        await ReloadFromFirstPage();
    }

    private async Task ApplyTo(string? value)
    {
        _to = DateOnly.TryParse(value, out var d) ? d : null;
        await ReloadFromFirstPage();
    }

    private async Task ApplyMin(string? value)
    {
        _min = ParseAmount(value);
        await ReloadFromFirstPage();
    }

    private async Task ApplyMax(string? value)
    {
        _max = ParseAmount(value);
        await ReloadFromFirstPage();
    }

    // Le champ number renvoie toujours un point décimal, quelle que soit la culture.
    private static decimal? ParseAmount(string? value) =>
        decimal.TryParse(value, System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture, out var d)
            ? d
            : null;

    private async Task ResetFilters()
    {
        _text = null;
        _status = null;
        _from = null;
        _to = null;
        _min = null;
        _max = null;
        await ReloadFromFirstPage();
    }

    private async Task SortBy(InvoiceSort column)
    {
        if (_sort == column)
        {
            _desc = !_desc;
        }
        else
        {
            _sort = column;
            // Dates et montants sont plus utiles du plus grand au plus petit,
            // les libellés dans l'ordre alphabétique.
            _desc = column is InvoiceSort.Date or InvoiceSort.Amount;
        }
        await ReloadFromFirstPage();
    }

    private async Task GoToPage(int page)
    {
        _pageNumber = page;
        await Load();
    }

    private async Task MarkPaidAsync(int id)
    {
        _error = null;
        _success = null;
        try
        {
            await InvoiceService.MarkAsPaidAsync(id);
            _success = "Rechnung als bezahlt markiert. Die Einnahme steht im Journal.";
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        await Load();
    }

    private async Task ConfirmIssueAsync()
    {
        if (_pendingIssue is null) return;

        _error = null;
        _success = null;
        _issuing = true;
        try
        {
            var issued = await InvoiceService.IssueAsync(_pendingIssue.Id);
            _success = $"Rechnung {issued.InvoiceNumber} ausgestellt und archiviert.";
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _issuing = false;
            _pendingIssue = null;
            await Load();
        }
    }

    private async Task ConfirmCancelAsync()
    {
        if (_pendingCancel is null) return;

        _error = null;
        _success = null;
        _working = true;
        try
        {
            var storno = await InvoiceService.CancelAsync(_pendingCancel.Id);
            _success = $"Stornorechnung {storno.InvoiceNumber} erstellt und archiviert.";
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
            _pendingCancel = null;
            await Load();
        }
    }

    private async Task DuplicateAsync(int id)
    {
        var copy = await InvoiceService.DuplicateAsDraftAsync(id);
        Nav.NavigateTo($"/app/rechnungen/{copy.Id}");
    }

    private async Task ConfirmCorrectAsync()
    {
        if (_pendingCorrect is null) return;

        _error = null;
        _success = null;
        _working = true;
        try
        {
            var draft = await InvoiceService.CorrectAsync(_pendingCorrect.Id);
            Nav.NavigateTo($"/app/rechnungen/{draft.Id}");
            return;
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
            _pendingCorrect = null;
        }
        await Load();
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is null) return;
        _error = null;
        try
        {
            await InvoiceService.DeleteDraftAsync(_pendingDelete.Id);
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        _pendingDelete = null;
        await Load();
    }

    private static string StatusLabel(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Draft => "Entwurf",
        InvoiceStatus.Issued => "Gestellt",
        InvoiceStatus.Paid => "Bezahlt",
        InvoiceStatus.Cancelled => "Storniert",
        _ => s.ToString()
    };

    private static string StatusClass(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Draft => "bg-secondary",
        InvoiceStatus.Issued => "bg-primary",
        InvoiceStatus.Paid => "bg-success",
        InvoiceStatus.Cancelled => "bg-dark",
        _ => "bg-secondary"
    };
}
