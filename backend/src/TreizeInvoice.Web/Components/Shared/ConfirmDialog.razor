@* Confirmation centrée dans la fenêtre. Les anciens panneaux étaient rendus en bas
   de page : hors de l'écran, un clic sur Ausstellen semblait sans effet. *@

<div class="dialog-backdrop" @onclick="OnCancel">
    <div class="dialog-box @(Danger ? "danger" : null)" role="alertdialog" aria-modal="true"
         aria-labelledby="dialogTitle" @onclick:stopPropagation="true">
        <h2 id="dialogTitle">@Title</h2>
        <div class="dialog-body">@ChildContent</div>
        <div class="dialog-actions">
            <button type="button" class="btn @(Danger ? "btn-danger" : "btn-primary")"
                    disabled="@Busy" @onclick="OnConfirm">
                @(Busy ? BusyLabel : ConfirmLabel)
            </button>
            <button type="button" class="btn" disabled="@Busy" @onclick="OnCancel">Abbrechen</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ConfirmLabel { get; set; } = string.Empty;
    [Parameter] public string BusyLabel { get; set; } = "Einen Moment…";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
