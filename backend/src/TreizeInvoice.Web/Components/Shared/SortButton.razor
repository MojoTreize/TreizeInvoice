@* En-tête de colonne cliquable : affiche le sens du tri actif. *@
@using TreizeInvoice.Services.Invoicing

<button type="button" class="sort-btn @(IsActive ? "active" : null)"
        aria-label="@AriaLabel"
        @onclick="() => OnSort.InvokeAsync(Column)">
    @ChildContent
    <span class="sort-mark" aria-hidden="true">@(IsActive ? (Descending ? "▼" : "▲") : "↕")</span>
</button>

@code {
    [Parameter, EditorRequired] public InvoiceSort Column { get; set; }
    [Parameter, EditorRequired] public InvoiceSort Current { get; set; }
    [Parameter] public bool Descending { get; set; }
    [Parameter] public EventCallback<InvoiceSort> OnSort { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsActive => Column == Current;

    private string AriaLabel => IsActive
        ? (Descending ? "Absteigend sortiert, klicken für aufsteigend" : "Aufsteigend sortiert, klicken für absteigend")
        : "Nach dieser Spalte sortieren";
}
